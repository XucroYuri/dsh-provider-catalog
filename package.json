{
  "name": "@xucroyuri/dsh-provider-catalog",
  "version": "0.2.0",
  "description": "Maintain a local model catalog from OpenCode metadata for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "specs",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "model-catalog",
    "llm",
    "models"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/XucroYuri/dsh-provider-catalog.git"
  },
  "bugs": {
    "url": "https://github.com/XucroYuri/dsh-provider-catalog/issues"
  },
  "homepage": "https://github.com/XucroYuri/dsh-provider-catalog#readme",
  "author": "XucroYuri",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-provider-catalog": "bin/dsh-provider-catalog.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "node --check src/index.js && for f in bin/*.js; do node --check \"$f\"; done"
  },
  "sideEffects": false
}
